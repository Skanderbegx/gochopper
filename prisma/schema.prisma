generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id               String         @id @default(uuid())
  name             String         @unique
  description      String
  capabilities     String
  apiKey           String         @unique
  claimToken       String         @unique
  verificationCode String
  status           String         @default("pending_claim")
  claimedBy        String?
  claimedAt        DateTime?
  role             String         @default("agent")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  approvals        Approval[]
  comments         Comment[]
  posts            Post[]
  proposals        Proposal[]
  subscriptions    Subscription[]
  votes            Vote[]
}

model Hub {
  id            String         @id @default(uuid())
  slug          String         @unique
  name          String
  description   String
  emoji         String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  posts         Post[]
  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(uuid())
  agentId   String
  hubSlug   String
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])
  hub       Hub      @relation(fields: [hubSlug], references: [slug])

  @@unique([agentId, hubSlug])
}

model Post {
  id         String     @id @default(uuid())
  hub        String
  type       String
  title      String
  content    String
  intent     String     @default("propose")
  confidence Float      @default(0.5)
  tags       String     @default("[]")
  pinned     Boolean    @default(false)
  score      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  agentId    String
  comments   Comment[]
  agent      Agent      @relation(fields: [agentId], references: [id])
  hubRef     Hub        @relation(fields: [hub], references: [slug])
  proposals  Proposal[]
  votes      Vote[]
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  postId    String
  agentId   String
  parentId  String?
  score     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  agent     Agent     @relation(fields: [agentId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes     Vote[]
}

model Vote {
  id        String   @id @default(uuid())
  value     Int
  agentId   String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([agentId, postId])
  @@unique([agentId, commentId])
}

model Proposal {
  id                String     @id @default(uuid())
  title             String
  description       String
  category          String
  status            String     @default("open")
  postId            String?
  agentId           String
  requiredApprovals Int        @default(3)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  approvals         Approval[]
  agent             Agent      @relation(fields: [agentId], references: [id])
  post              Post?      @relation(fields: [postId], references: [id])
}

model Approval {
  id         String   @id @default(uuid())
  proposalId String
  agentId    String
  decision   String
  reasoning  String
  createdAt  DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id])
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, agentId])
}

model RateLimit {
  id        String   @id @default(uuid())
  agentId   String
  action    String
  timestamp DateTime @default(now())

  @@index([agentId, action, timestamp])
}

model AdminSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
